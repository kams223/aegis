<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="passive_aircraft">
    <link name="body">
      <inertial>
        <pose>-0.048 0.0 0.026999999999999996 0 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.173697</ixx>
          <iyy>0.19464525</iyy>
          <izz>0.35683575</izz>
          <ixy>0</ixy>
          <ixz>0.006048</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="fuselage_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>1.2 0.12 0.16</size>
          </box>
        </geometry>
      </collision>
      <visual name="fuselage_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>1.2 0.12 0.16</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.25 0.5 0.8 1</diffuse>
          <ambient>0.25 0.5 0.8 1</ambient>
        </material>
      </visual>
      <collision name="wing_collision">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <box>
            <size>0.24 1.8 0.04</size>
          </box>
        </geometry>
      </collision>
      <visual name="wing_visual">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <box>
            <size>0.24 1.8 0.04</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.25 0.5 0.8 1</diffuse>
          <ambient>0.25 0.5 0.8 1</ambient>
        </material>
      </visual>
      <collision name="tailplane_collision">
        <pose>-0.48 0 0.06 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.6 0.03</size>
          </box>
        </geometry>
      </collision>
      <visual name="tailplane_visual">
        <pose>-0.48 0 0.06 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.6 0.03</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.25 0.5 0.8 1</diffuse>
          <ambient>0.25 0.5 0.8 1</ambient>
        </material>
      </visual>
      <collision name="fin_collision">
        <pose>-0.48 0 0.18 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.03 0.24</size>
          </box>
        </geometry>
      </collision>
      <visual name="fin_visual">
        <pose>-0.48 0 0.18 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.03 0.24</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.25 0.5 0.8 1</diffuse>
          <ambient>0.25 0.5 0.8 1</ambient>
        </material>
      </visual>
      <sensor name="ground_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <contact>
          <collision>fuselage_collision</collision>
          <collision>wing_collision</collision>
          <collision>tailplane_collision</collision>
          <collision>fin_collision</collision>
        </contact>
      </sensor>
      <sensor name="imu" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/aegis/sensors/imu</topic>
        <imu />
      </sensor>
      <sensor name="gnss" type="navsat">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/aegis/sensors/gnss</topic>
        <navsat />
      </sensor>
      <sensor name="barometer" type="air_pressure">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>/aegis/sensors/barometer</topic>
        <air_pressure />
      </sensor>
    </link>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <topic>/aegis/aircraft/pose</topic>
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>100</update_frequency>
    </plugin>
  </model>
</sdf>